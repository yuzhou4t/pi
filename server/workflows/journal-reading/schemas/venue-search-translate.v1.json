{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "translations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "zh": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "required": ["id", "zh"],
        "additionalProperties": false
      }
    }
  },
  "required": ["translations"],
  "additionalProperties": false
}
