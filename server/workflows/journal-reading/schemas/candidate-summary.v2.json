{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "paper_id": {
            "type": "string",
            "minLength": 1
          },
          "selection_summary": {
            "type": "string",
            "minLength": 12,
            "maxLength": 220
          },
          "project_impact": {
            "type": "string",
            "minLength": 4,
            "maxLength": 260
          }
        },
        "required": [
          "paper_id",
          "selection_summary",
          "project_impact"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
