{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "search_queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      }
    },
    "from_year": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    }
  },
  "required": ["search_queries"],
  "additionalProperties": false
}
