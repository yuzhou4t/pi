{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "problem": {
      "type": "string",
      "minLength": 4,
      "maxLength": 500
    },
    "why_read": {
      "type": "string",
      "minLength": 4,
      "maxLength": 300
    },
    "intuition": {
      "type": "string",
      "minLength": 4,
      "maxLength": 600
    },
    "evidence": {
      "type": "string",
      "minLength": 4,
      "maxLength": 600
    },
    "limitations": {
      "type": "string",
      "minLength": 4,
      "maxLength": 400
    },
    "questions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 180
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^block-[a-f0-9]{20}$"
      }
    }
  },
  "required": [
    "paper_id",
    "problem",
    "why_read",
    "intuition",
    "evidence",
    "limitations",
    "questions",
    "evidence_refs"
  ],
  "additionalProperties": false
}
