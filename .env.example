# 日常运行默认且推荐使用 live；fixture 只允许显式开发/测试环境。
PI_MODEL_MODE=live
PI_DEFAULT_PROVIDER=codex-subscription

# 正常工作：Pi SDK 会话、事件与过滤快照的服务端存储。
# macOS 默认使用 ~/Library/Application Support/Pi Agent/project-work。
# PI_PROJECT_WORK_STORAGE_ROOT=

# GPT 订阅：复用本机 Codex CLI 的 ChatGPT 登录态，不需要 OpenAI API Key。
PI_CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
PI_CODEX_TIMEOUT_MS=90000
# 期刊标题/摘要专用翻译模型；默认固定为当前 Codex 目录可选的 5.3 Spark。
PI_JOURNAL_TRANSLATION_MODEL=gpt-5.3-codex-spark

# DeepSeek API：只在本地服务进程中读取，不会发送给浏览器。
# 可选模型：deepseek-v4-pro / deepseek-v4-flash。
PI_DEEPSEEK_API_KEY=
PI_DEEPSEEK_TIMEOUT_MS=45000

# 正常工作按当前消息启用的外部检索；未配置时界面会明确显示不可用。
# Key 只由本地服务进程读取，不会发送给浏览器或写入会话。
# 优先用完豆包搜索 Custom 每月 500 次免费额度，随后自动回退到 Tavily；Tavily 也按每月 1000 次硬上限保护。
# 这里需要豆包搜索的独立 API Key，不是火山方舟模型 API Key；豆包只返回结构化检索结果。
# 设置 -> 额度与用量会显示两项额度；GitHub 共享账本让两台设备看到同一个余额。
PI_DOUBAO_SEARCH_API_KEY=
PI_TAVILY_API_KEY=
PI_CONTEXT7_API_KEY=
PI_SEARCH_QUOTA_GITHUB_REPOSITORY=yuzhou4t/pi
PI_SEARCH_QUOTA_GITHUB_BRANCH=quota-state
PI_SEARCH_QUOTA_PROJECT_ID=pi-agent
# 可选：专用 GitHub Token；留空时使用本机已登录的 gh CLI，不读取或复制其 Token。
PI_SEARCH_QUOTA_GITHUB_TOKEN=

# 正常工作的受控图片生成复用上面同一个 Codex CLI 与 ChatGPT 订阅登录。
# 不读取或复制 Codex 凭据。

# MinerU 云端精解析：每轮最终 5 篇候选都会尝试提交。
# Token 只保存在 .env.local；不要写入浏览器、聊天或 Git。
PI_MINERU_API_TOKEN=
PI_MINERU_BASE_URL=https://mineru.net/api/v4
PI_MINERU_POLL_INTERVAL_MS=10000
PI_MINERU_TIMEOUT_MS=1800000

# Zotero Desktop：只连接本机回环地址；写入仍需在界面核对精确预览并确认。
PI_ZOTERO_BASE_URL=http://127.0.0.1:23119

# Obsidian：固定精读笔记目标目录；正式写入必须先展示精确预览并显式确认。
PI_OBSIDIAN_NOTE_DIR=

# 项目状态：所有消费者共用同一个结构化 Markdown 事实源。
PI_PROJECT_ROOT=.
PI_PROJECT_STATE_PATH=project_state.md

# 可选：OpenAlex polite-pool 联系邮箱，只用于补充摘要和公开访问链接。
PI_OPENALEX_MAILTO=

# 缓存和不含论文正文的调用审计不会进入 Git。
PI_DATA_DIR=.pi-agent
